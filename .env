# Cô chỉ cần mở file này và dán API key vào dòng dưới nếu muốn bật OpenAI.
# Nếu để trống, ứng dụng vẫn chạy với chế độ fallback có sẵn.
OPENAI_API_KEY=

# Cổng mặc định để chạy ứng dụng.
APP_PORT=8001

# fixed: giữ nguyên cổng trên, auto: tự tìm cổng trống nếu đang bị chiếm.
START_PORT_MODE=fixed

# 1/true/yes/on để tự mở trình duyệt khi server sẵn sàng.
AUTO_OPEN_BROWSER=0
