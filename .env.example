# Dien API key OpenAI neu muon bat AI chat dung model OpenAI.
OPENAI_API_KEY=

# Cong mac dinh de chay app.
APP_PORT=8001

# fixed: dung dung cong tren; auto: tu tim cong trong neu cong da bi chiem.
START_PORT_MODE=fixed

# 1/true/yes/on de tu mo trinh duyet sau khi server san sang.
AUTO_OPEN_BROWSER=0
